{
  "name": "@web3auth/react-native-sdk",
  "version": "10.0.0",
  "description": "Web3Auth SDK that supports Bare (Standalone) and Expo React Native apps.",
  "sideEffects": false,
  "main": "dist/lib.cjs/index.js",
  "module": "dist/lib.esm/index.js",
  "source": "src/index.ts",
  "types": "dist/lib.cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.cjs/index.d.ts",
      "import": "./dist/lib.esm/index.js",
      "require": "./dist/lib.cjs/index.js"
    },
    "./wagmi": {
      "types": "./dist/lib.cjs/react/wagmi/index.d.ts",
      "import": "./dist/lib.esm/react/wagmi/index.js",
      "require": "./dist/lib.cjs/react/wagmi/index.js"
    },
    "./solana": {
      "types": "./dist/lib.cjs/react/solana/index.d.ts",
      "import": "./dist/lib.esm/react/solana/index.js",
      "require": "./dist/lib.cjs/react/solana/index.js"
    },
    "./metro-config": {
      "require": "./src/metro/metro-config.js"
    },
    "./setup": {
      "import": "./src/metro/setup.js",
      "require": "./src/metro/setup.js"
    },
    "./src/metro/shims/url-shim.js": {
      "require": "./src/metro/shims/url-shim.js"
    }
  },
  "files": [
    "dist",
    "src/metro"
  ],
  "scripts": {
    "build": "vp pack",
    "lint": "vp lint",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release-packages": "changeset publish",
    "prepack": "npm run build",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web3auth/web3auth-react-native-sdk.git"
  },
  "author": "Web3Auth",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/web3auth/web3auth-react-native-sdk/issues"
  },
  "homepage": "https://github.com/web3auth/web3auth-react-native-sdk#readme",
  "keywords": [
    "expo",
    "react-native",
    "torus",
    "web3",
    "web3auth"
  ],
  "dependencies": {
    "@solana/client": "^1.7.0",
    "@solana/keys": "^2.3.0",
    "@solana/kit": "^6.10.0",
    "@solana/wallet-standard-features": "^1.4.0",
    "@toruslabs/base-controllers": "^10.0.0",
    "@toruslabs/constants": "^17.0.0",
    "@toruslabs/ethereum-controllers": "^10.0.0",
    "@toruslabs/fetch-node-details": "^17.0.0",
    "@toruslabs/http-helpers": "^10.1.0",
    "@toruslabs/loglevel-sentry": "^10.0.0",
    "@toruslabs/metadata-helpers": "^9.0.0",
    "@toruslabs/session-manager": "^6.0.0",
    "@toruslabs/torus.js": "^19.0.0",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "@web3auth/auth": "^12.0.0",
    "@web3auth/base": "^9.7.0",
    "@web3auth/base-provider": "^9.7.0",
    "@web3auth/ethereum-provider": "^9.7.0",
    "@web3auth/no-modal": "^11.3.0",
    "@web3auth/ws-embed": "^6.1.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "deepmerge": "^4.3.1",
    "empty-module": "^0.0.2",
    "events": "^3.3.0",
    "fast-text-encoding": "^1.0.6",
    "jwt-decode": "^4.0.0",
    "lodash.clonedeep": "^4.5.0",
    "lodash.merge": "^4.6.2",
    "lodash.unionby": "^4.8.0",
    "loglevel": "^1.9.2",
    "react-native-url-polyfill": "^2.0.0",
    "readable-stream": "^4.5.2",
    "urijs": "^1.19.11"
  },
  "peerDependencies": {
    "@solana/react-hooks": "^1.4.0",
    "@tanstack/react-query": ">=5.0.0",
    "@wagmi/core": ">=3.0.0",
    "react": ">=18",
    "react-native": "*",
    "react-native-quick-crypto": ">=0.7.0",
    "viem": ">=2.45.0",
    "vue": ">=3.x",
    "wagmi": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@solana/react-hooks": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "@wagmi/core": {
      "optional": true
    },
    "viem": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "react-native-quick-crypto": {
      "optional": true
    },
    "wagmi": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/runtime": "^7.27.6",
    "@changesets/cli": "^3.0.3",
    "@lavamoat/harden": "^0.9.0",
    "@solana/react-hooks": "^1.4.1",
    "@tanstack/react-query": "^5.90.2",
    "@toruslabs/config": "^5.0.0",
    "@toruslabs/oxlint-config-react": "^1.0.0",
    "@toruslabs/torus-scripts": "9.0.1",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/lodash.unionby": "^4.8.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.10",
    "@types/react-native": "^0.73.0",
    "@types/react-test-renderer": "^19.1.0",
    "@types/urijs": "^1.19.25",
    "@wagmi/core": "^3.4.7",
    "eslint": "^9.29.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.1",
    "react": "^19.1.1",
    "react-native": "~0.80.0",
    "react-test-renderer": "^19.1.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "viem": "^2.55.8",
    "vite-plus": "1.7.0",
    "vue": "^3.x",
    "wagmi": "^3.6.8"
  },
  "typesVersions": {
    "*": {
      "wagmi": [
        "./dist/lib.cjs/react/wagmi/index.d.ts"
      ],
      "solana": [
        "./dist/lib.cjs/react/solana/index.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=12"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0",
      "onFail": "error"
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vitest": "5.1.0"
  }
}
