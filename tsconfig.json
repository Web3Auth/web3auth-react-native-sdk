{
  "extends": "@toruslabs/config/tsconfig.library.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
    // Keep module esnext and moduleResolution bundler so source can import ESM-only
    // packages (wallet-standard). Do not set package.json "type": "module" or the
    // Metro require entrypoints break.
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
